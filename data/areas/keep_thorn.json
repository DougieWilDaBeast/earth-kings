    {
      "name": "a knight of the muster",
      "unit": "castellan",
      "cell": [
        6,
        7
      ],
      "facing": [
        1,
        0
      ],
      "wander": 3,
      "chatter": [
        "Knee high. It was ankle high when I swore in.",
        "We drill in the scrub now. It is honest ground, at least."
      ],
      "talk": {
        "refuse": {
          "chance": 0.5,
          "text": "The knight does not look at you. The knight is drilling, alone, in the long grass.",
          "check": {
            "skill": "renown",
            "dc": 11
          },
          "check_q": "Fall in beside him.",
          "won": "...Not bad. Not good. Not bad. What is it?",
          "won_flag": "thorn_knight:won",
          "unless": "thorn_knight:won",
          "still_no": "Out of step. Go away.",
          "leave": "Leave him to it."
        },
        "hello": "One. Two. One. Two.",
        "ask": [
          {
            "q": "Why drill if nobody's left?",
            "a": "So that when they come back, someone remembers how."
          }
        ],
        "bye": "One. Two."
      }
    },
    {
      "name": "Ilm the Butler",
      "unit": "devil_butler",
      "cell": [
        12,
        6
      ],
      "facing": [
        -1,
        0
      ],
      "wander": 2,
      "chatter": [
        "Ser Valis takes his supper in the hall. Alone. Every night.",
        "The thorn comes in under the door. I sweep it back out."
      ],
      "talk": {
        "hello": "The muster hall is that way. The muster, I regret, is not.",
        "ask": [
          {
            "q": "Where did everyone go?",
            "a": "To a war, sir or madam. Several wars. None of them came back to tell us which one they won."
          }
        ],
        "sells": [
          {
            "item": "red_draught"
          },
          {
            "item": "blue_draught"
          },
          {
            "item": "ale_flask"
          }
        ],
        "shop": "From the keep's stores. Such as they are.",
        "bye": "Do come again. Someone should."
      }
    },
    {
      "name": "a caterpillar on the rampart",
      "unit": "caterpillar_warrior",
      "cell": [
        5,
        3
      ],
      "facing": [
        0,
        1
      ],
      "wander": 3,
      "chatter": [
        "It walks the rampart end to end all day, like the last sentry left."
      ]
    },
    {
      "name": "the Fox Fire Knight",
      "unit": "fox_knight",
      "cell": [
        15,
        10
      ],
      "facing": [
        -1,
        0
      ],
      "story_npc": "fox_knight",
      "talk": {
        "hello": [
          "You may speak. Briefly.",
          "I do not take company. You may take a moment."
        ],
        "again": [
          "You again. Say what you came to say.",
          "Still breathing, I see. Good. Fewer names."
        ],
        "ask": [
          {
            "q": "Whose sigil is that?",
            "a": "The Fox Fire. A spirit that lights the brush to lead hunters into the bog. My own banner is ash in a courtyard in the southern marches."
          },
          {
            "q": "Why ride alone?",
            "a": "Every companion is a name I would have to carry. I am carrying enough."
          },
          {
            "q": "What do you want with this keep?",
            "a": "Its knights march against the Empire sooner or later. When they do, I will be in front of them."
          }
        ],
        "bye": [
          "Go.",
          "May your house outlast mine."
        ]
      }
    }
  ],
