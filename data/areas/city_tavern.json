    "spots": [
        {
            "cell": [
                10,
                14
            ],
            "line": "The Flagon is loud the way only a city tavern is: forty conversations and every one of them about the Tower."
        },
        {
            "cell": [
                4,
                11
            ],
            "line": "Over the fire, a board of names: everyone from the city who climbed past the fifth floor. Some have a second date chalked beside them."
        }
    ],
