  "people": [
    {
      "name": "Wenna the Guild Clerk",
      "unit": "guild_clerk",
      "cell": [
        9,
        7
      ],
      "facing": [
        0,
        1
      ],
      "guild": true,
      "chatter": [
        "Contracts for the city are posted inside. Contracts for everywhere else, out here with me.",
        "Every company passes this gate eventually. I keep the list."
      ]
    },
    {
      "name": "Tollmaster Crane",
      "unit": "castellan",
      "cell": [
        13,
        7
      ],
      "facing": [
        0,
        1
      ],
      "chatter": [
        "Name, business, and a copper for the gate.",
        "No goats past the gate. No exceptions. Two exceptions."
      ],
      "talk": {
        "hello": [
          "Name, business, and a copper for the gate. The copper is the important part.",
          "Through you go. Mind the queue. Mind the goats."
        ],
        "ask": [
          {
            "q": "What's in there?",
            "a": "Everything. A cathedral, a market, the Watch, the Gilded Flagon. Ten thousand people who all think they're the only one in a hurry."
          },
          {
            "q": "Who rules the city?",
            "a": "The Margrave, on paper. The Watch, on the street. The brewers, after dark."
          },
          {
            "q": "Why the walls?",
            "a": "The gates out there. When one breaks, everything in the country runs for somewhere with walls. We'd like it to be us they run to, not us they run over."
          }
        ],
        "bye": "Keep your purse in front of you. The city's honest. Mostly."
      }
    },
    {
      "name": "a pilgrim come for the dawn rite",
      "unit": "town_elder",
      "cell": [
        12,
        11
      ],
      "facing": [
        0,
        -1
      ],
      "wander": 2,
      "chatter": [
        "Three days walking to hear one rite. I'll be late for it, I know I will.",
        "They say the Cathedral looks at the Tower. I want to see that."
      ]
    },
    {
      "name": "Hask the Caravan Guard",
      "unit": "bird_archer",
      "cell": [
        5,
        12
      ],
      "facing": [
        1,
        0
      ],
      "chatter": [
        "Forty days from the dunes and the gate shuts on us at dusk.",
        "Ask me about wolves. No, don't."
      ],
      "rounds": [
        {
          "cell": [
            5,
            12
          ],
          "line": "Warms his hands at the cold fire, out of habit."
        },
        {
          "cell": [
            8,
            11
          ],
          "line": "Counts the barrels again.",
          "stay": 4
        },
        {
          "cell": [
            10,
            9
          ],
          "line": "Waters the mules at the trough."
        }
      ]
    },
    {
      "name": "Peg the Goat-seller",
      "unit": "peasant",
      "cell": [
        19,
        10
      ],
      "facing": [
        0,
        1
      ],
      "chatter": [
        "Goats! Fine goats! Not allowed in the city, so cheap!"
      ],
      "talk": {
        "hello": "Goats! Fine goats! Not allowed in the city, which is why they're cheap.",
        "ask": [
          {
            "q": "Why aren't goats allowed in?",
            "a": "One ate the Margrave's hat. Not the Margrave's. The old one's. Grudges in there go back."
          }
        ],
        "sells": [
          {
            "item": "cheese"
          },
          {
            "item": "bread"
          },
          {
            "item": "apple",
            "restock": true
          }
        ],
        "shop": "No goats for you, then. Cheese? It's goat.",
        "bye": "Tell them in there Peg sent you. They won't care, but tell them."
      }
    },
    {
      "name": "Ensign Rowe of the Watch",
      "unit": "legion_copper",
      "cell": [
        12,
        15
      ],
      "facing": [
        0,
        1
