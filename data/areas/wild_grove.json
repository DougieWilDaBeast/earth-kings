    "people": [
        {
            "name": "Oakwarden Bramble",
            "unit": "tree_sentinel",
            "cell": [
                14,
                11
            ],
            "facing": [
                0,
                1
            ],
            "wander": 3,
            "chatter": [
                "My roots go down further than your castles go up.",
                "Rest your boots here a moment, traveller. The road will wait.",
                "Birds nested in my branches twice this spring. I let them."
            ]
        },
        {
            "name": "Sera the Longbow",
            "unit": "sera",
            "cell": [
                20,
                7
            ],
            "facing": [
                0,
                1
            ],
            "story_npc": "sera",
            "talk": {
                "hello": [
                    "Don't step there. Wolf sign. Well, now you've stepped there.",
                    "You're loud for someone this far from a road."
                ],
                "again": [
                    "Back again. The trees noticed before I did.",
                    "Quieter this time. Better."
                ],
                "ask": [
                    {
                        "q": "Why live out here?",
                        "a": "Walls feel like cages. Out here the wind tells you what's coming. In a town it's the walls that tell you, after."
                    },
                    {
                        "q": "What are you hunting?",
                        "a": "Whatever the blight pushed out of the marsh. It took the cabin, and the people in it. I spent a quiver on it from an oak and it wasn't enough."
                    },
                    {
                        "q": "Do you know Bram?",
                        "a": "The big one with the scar and the speeches? He keeps the ford. Tell him I'm not coming back to sleep in a bed."
                    }
                ],
                "bye": [
                    "Walk on the moss, not the twigs.",
                    "Go on. I'll know if you come back."
                ]
            }
        }
    ],
