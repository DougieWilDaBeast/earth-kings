  "people": [
    {
      "name": "Maren the Guide",
      "unit": "staff_panda",
      "cell": [
        12,
        10
      ],
      "facing": [
        0,
        1
      ],
      "chatter": [
        "Welcome to Hearthwick!",
        "Come and ask me anything."
      ],
      "talk": {
        "hello": "Welcome to Hearthwick! Everyone here is glad to show a new face how things work. Ask me anything.",
        "again": [
          "Back again? Ask away.",
          "Still here? Good. Ask me something."
        ],
        "ask": [
          {
            "q": "What are the gates?",
            "a": "Doors in the world that shouldn't be there. Monsters pour out of the open ones. Go in, fight through every floor, and the gate shuts behind you for good. Leave one too long and it breaks, and what was inside comes out stronger.",
            "set_flag": "tut:asked"
          },
          {
            "q": "What's the Tower?",
            "a": "The thing you can see from everywhere. A hundred floors, a new chapter every five. Every floor pays, and every floor is a choice about what you're already carrying.",
            "set_flag": "tut:asked"
          },
          {
            "q": "What happens if someone falls?",
            "a": "They may not get up. A charm, a friend still standing, a book they've read: any of those might save them. Companions can be lost and the road goes on. If your own hero falls, that world is over.",
            "set_flag": "tut:asked"
          },
          {
            "q": "How do I get stronger?",
            "a": "Meet new things. The first time your company beats a kind of creature, somebody learns from it. Gear helps, from shops and chests. So do books, from the libraries.",
            "set_flag": "tut:asked"
          },
          {
            "q": "Who else lives here?",
            "a": "Pim keeps the stall. Smudge the fox won't talk to anyone without a coin. Wren has lost something, I'd bet. And Captain Harrow keeps a sparring pair out in the field south of the square, for anyone who wants to learn how a fight starts.",
            "set_flag": "tut:asked"
          }
        ],
        "more": [
          "Anything else?",
          "What else?"
        ],
        "bye": "Good luck out there. Mind the fox."
      }
    },
    {
      "name": "Pim the Stallholder",
      "unit": "peasant",
      "cell": [
        9,
        6
      ],
      "facing": [
        0,
        1
      ],
      "chatter": [
        "Bread! Apples! Draughts for the road!",
        "Coin first, mind."
      ],
      "talk": {
        "hello": [
          "Buying or browsing? Browsing's free. Buying's better.",
          "Fresh this morning! Most of it."
        ],
        "ask": [
          {
            "q": "What are draughts for?",
            "a": "Drink one in a fight and a wound closes. Red's cheap and does a little. Blue does more. The amber ones I can't afford to stock."
          }
        ],
        "sells": [
          {
            "item": "bread",
            "set_flag": "tut:bought",
            "restock": true
          },
          {
            "item": "apple",
            "set_flag": "tut:bought",
            "restock": true
          },
          {
            "item": "red_draught",
            "set_flag": "tut:bought"
          },
          {
            "item": "padded_coat",
            "set_flag": "tut:bought"
          },
          {
            "item": "hunting_bow",
            "set_flag": "tut:bought"
          }
        ],
        "shop": "Have a look. Food and draughts go in the packs; gear goes to whoever can use it best.",
        "sold": [
          "Pleasure doing business.",
          "Good choice."
        ],
        "bye": "Come back when you're hungry."
      }
    },
    {
      "name": "Smudge the Fox",
      "unit": "hat_fox",
      "cell": [
        15,
        8
      ],
      "facing": [
        -1,
        0
      ],
      "wander": 1.5,
      "chatter": [
        "The fox watches your purse.",
        "The fox adjusts its hat."
      ],
      "talk": {
        "refuse": {
          "text": [
            "The fox looks at you, then at your purse, then pointedly away.",
            "The fox yawns, very wide, so you can see all of its teeth."
          ],
          "bribe": 50,
          "bribe_q": "Toss it a coin. (50 copper)",
          "check": {
            "skill": "wits",
            "dc": 8
          },
          "check_q": "Pretend you haven't noticed it.",
          "won": "The fox sits. It waits. It seems to expect a question.",
          "still_no": "The fox has noticed you pretending.",
          "won_flag": "tut:fox",
          "unless": "tut:fox",
          "leave": "Leave the fox be."
        },
        "hello": "The fox tilts its hat at you. It is, somehow, a greeting.",
        "ask": [
          {
            "q": "Why won't you talk to anyone?",
            "a": "Everybody wants something from a fox, the look says. At least you paid."
          },
          {
            "q": "Know any secrets?",
            "a": "Its tail flicks towards the cart. Then it looks at you as if you should already have known."
          }
        ],
        "more": "The fox waits.",
        "leave": "Leave it.",
        "bye": "The fox is already looking at someone else's purse."
      }
    },
    {
      "name": "Wren",
      "unit": "cabin_boy",
      "cell": [
        6,
        10
      ],
      "facing": [
        1,
        0
      ],
      "chatter": [
        "Where did it go...",
        "It was right here."
      ],
      "talk": {
        "hello": "Oh! Hello. Sorry. I'm looking for something.",
        "again": "Did you see it anywhere?",
        "job": {
          "flag": "job:tut_horse",
          "done_flag": "found:tut_horse",
          "ask": "Can I help you look?",
          "offer": "My wooden horse. Da carved it. I was playing by the log pile on the far side of the square, and now it's gone.",
          "accept": "I'll find it.",
          "decline": "Not right now.",
          "thanks": "Thank you! Things worth a look have a ? over them, Da says.",
          "waiting": "Did you find it?",
          "hand_over": "Here's your horse.",
          "not_yet": "Not yet.",
          "done": "That's him! Thank you! Here, Da gave me these for being good. You've been better.",
          "gold": 400,
          "item": "apple"
        },
        "bye": "Bye!"
      }
    },
    {
      "name": "Captain Harrow",
      "unit": "golden_knight",
      "cell": [
        18,
        6
      ],
      "facing": [
        0,
        1
      ],
      "chatter": [
        "Ready to spar?",
        "Mind the red ground."
      ],
      "talk": {
        "hello": "You'll want to know how to fight before the world teaches you the hard way.",
        "ask": [
          {
            "q": "How do fights start?",
            "a": "Out in the country, a band camps where it likes and paints the ground it can see red. Step into that red and you're fighting, right there, on that very ground. Long grass hides you; bursting out of it at them gets you the jump."
          },
          {
            "q": "How do fights work?",
            "a": "In real time, and they start paused. Space pauses and unpauses. Left-click a fighter, or drag a box round several. Right-click the ground to move, an enemy to attack, a fallen friend to help them up. Q, W, E and R use skills."
          },
          {
            "q": "Where's the sparring pair?",
            "a": "Out in the field south of the square, once you're ready for them: a goblin and a slime who've agreed to lose to you. Nothing they do in practice can kill you."
          },
          {
            "q": "Any advice?",
            "a": "Facing matters: hit them from the side or behind. Keep your healer at the back. And pause whenever you need to think. Nobody will laugh."
          }
        ],
        "bye": "Off you go. Mind the red."
      }
    }
  ],
