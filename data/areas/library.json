  "people": [
    {
      "name": "Ondry the Keeper",
      "unit": "neuron_chief",
      "cell": [
        9,
        7
      ],
      "facing": [
        0,
        1
      ],
      "wander": 2,
      "chatter": [
        "Read what you like. Put it back where it was, not where it should be.",
        "Half of this is wrong. I have not worked out which half.",
        "The lamps stay lit. That is the whole of my duty and it takes all day.",
        "Somebody copied a page badly two hundred years ago and we are all still living in it."
      ],
      "talk": {
        "hello": [
          "Quietly. The books are listening.",
          "You've come to read? Or to be read to? Both are permitted. Neither is encouraged."
        ],
        "ask": [
          {
            "q": "What is this place?",
            "a": "A reading hall. Before that, a fort. Before that, a reading hall. Things come round."
          },
          {
            "q": "Are the maps any good?",
            "a": "Three of the towns on them are not there. One of them is there and isn't on them. So: better than most."
          }
        ],
        "news": true,
        "sells": [
          {
            "item": "orrery_staff"
          },
          {
            "item": "lantern_staff"
          },
          {
            "item": "halo_robe"
          }
        ],
        "shop": "From the old armoury. The staves remember their owners. Ignore them.",
        "bye": "Return what you borrow. Especially ideas."
      }
    },
    {
      "name": "Wick the Duck Wizard",
      "unit": "duck_wizard",
      "cell": [
        13,
        5
      ],
      "facing": [
        -1,
        0
      ],
      "wander": 3,
      "chatter": [
        "I am not lost. I am between shelves.",
        "There is a book here that I am not allowed to want.",
        "Quills. They ask where I get the quills. I do not answer."
      ]
    },
    {
      "name": "a wisp above the stacks",
