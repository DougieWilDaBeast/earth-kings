  "people": [
    {
      "name": "Sennet, the Guild's Doorkeeper",
      "unit": "timeless_one",
      "cell": [
        16,
        9
      ],
      "facing": [
        0,
        1
      ],
      "wander": 1,
      "chatter": [
        "I am Sennet. I keep the Guild's register: shut a gate and I mark you for the Tower.",
        "I write the names down, going up. It is not much, but it is what I can do.",
        "Each floor is older than the one under it. Do not ask me how.",
        "Some come down. I have stopped guessing which."
      ],
      "guild": true
    },
    {
      "name": "Old Halloran, the Guild's Master",
      "unit": "town_elder",
      "cell": [
        18,
        9
      ],
      "facing": [
        0,
        1
      ],
      "wander": 1,
      "chatter": [
        "Halloran. I run the Guild, when Sennet lets me.",
        "Strongest man in the city, they say. They say it because I tell them to.",
        "Another one out of the sky! Sit, sit. No, not there, that chair bites.",
        "You've got the look of somebody who fell a long way. Good. The short falls never amount to much.",
        "Shut a gate and I'll mark you for the Tower myself. Floor one is the easy one, so naturally it kills the most people.",
        "Come back down and tell me about it. Nobody ever does. I'm starting to take it personally."
      ],
      "guild": true
    },
    {
      "name": "Bell the Cabin Hand",
      "unit": "cabin_boy",
      "cell": [
        8,
        13
      ],
      "facing": [
        1,
        0
      ],
      "wander": 3,
      "chatter": [
        "I carry the packs down. Never up. That's somebody else's job.",
        "They pay me by the pack. I have never had a slow week.",
        "You can leave a message with me. I keep them. All of them."
      ],
      "talk": {
        "hello": "Going up? Everyone goes up. Get your provisions down here; there's no shop on the fortieth floor.",
        "ask": [
          {
            "q": "How high does it go?",
            "a": "A hundred floors, they say. I've only ever seen people come down from the first ten."
          }
        ],
        "sells": [
          {
            "item": "bread"
          },
          {
            "item": "cheese"
          },
          {
            "item": "red_draught"
          },
          {
            "item": "blue_draught"
          },
          {
            "item": "herbs"
          }
        ],
        "shop": "Everything you'll wish you'd bought.",
        "bye": "See you on the way down. Hopefully."
      }
    },
    {
      "name": "a wisp at the stairhead",
      "unit": "feather_wisp",
      "cell": [
        9,
        9
      ],
      "facing": [
        1,
        0
      ],
      "wander": 1,
      "chatter": [
        "It drifts down two steps, thinks better of it, and goes back up."
      ]
    },
    {
      "name": "Buri Deepforge",
      "unit": "dwarf_smith",
      "cell": [
        21,
        12
      ],
      "facing": [
        0,
        1
      ],
      "story_npc": "dwarf_smith",
      "talk": {
        "hello": [
          "Hm. Your buckle's cracked. Second hole from the end.",
          "Mind that stair. Fourth stone's got a fault in it the size of my thumb.",
          "Third blade this month to come down out of a clear sky. Bring me one and I'll tell you whose it was."
        ],
        "again": [
          "Back. Buckle's still cracked.",
          "You again. I've been counting the faults in this tower. I've stopped at nine hundred."
        ],
        "ask": [
          {
            "q": "What's the third eye?",
            "a": "Opal, grafted by the guild elders. Sees stress in metal, heat in a forge, the lie in a bad weld. Bad at birthdays."
          },
          {
            "q": "What happened at the Iron Cairn?",
            "a": "Things came up the deep shafts. Seventy got out. Then I put a war sledge through the right pillar and the mountain did the rest."
          },
          {
            "q": "Why the Tower?",
            "a": "Everything that's wrong underground is wrong up there too. You can see it in the stones. Somebody built this to hold something in."
          }
        ],
        "bye": [
          "Hit things at the proper angle.",
          "Get that buckle seen to."
        ]
      }
    }
  ],
