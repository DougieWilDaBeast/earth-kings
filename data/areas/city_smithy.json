{
    "display_name": "the smithy",
    "_doc": "Play-test 8, ask 8 (call BX): the smithy, open; the smith works out back, his apprentice puts an edge on weapons (talk hone). Laid out by tools/build_interiors.py.",
    "people": [
        {
            "name": "Tam the Apprentice",
            "unit": "dwarf_smith",
            "facing": [
