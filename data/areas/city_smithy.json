            "recruit": false,
            "talk": {
                "hello": [
                    "Master's at the anvil out back. I do the edges. Edges are most of it.",
                    "Mind the sparks. And the dog. Mostly the sparks."
                ],
                "ask": [
                    {
                        "q": "Who's your master?",
                        "a": "Old Brannoc. He's made blades for the Watch for thirty years, and he still swears at every one of them."
                    },
                    {
                        "q": "What sells best?",
                        "a": "Spearheads for the Watch, nails for everyone else. Swords are for climbers, and climbers don't often come back for a second one."
                    }
                ],
                "hone": {
                    "q": "Can you put an edge on our weapons?",
                    "offer": "Lay them on the bench. Master checks my work, so it'll be good.",
                    "done": "There. Try it on a turnip, not your thumb."
                },
                "forge": {
                    "q": "Could you make us something?",
                    "offer": "Out of that? Master says ash and ore is how every smith started. I can do it.",
                    "none": "Bring me ore off the bare ground and ash staves out of the woods, and I'll make you a blade or a bow. The fee's for the coal.",
                    "done": "Done. Don't tell Master I used his good tongs."
                },
                "bye": "Keep it oiled. Rust is slower than a goblin, but it gets there."
            },
            "cell": [
                7,
                3
            ]
        }
