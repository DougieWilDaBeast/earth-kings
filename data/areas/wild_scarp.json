  "people": [
    {
      "name": "Vell of the High Ground",
      "unit": "bird_archer",
      "cell": [
        14,
        12
      ],
      "facing": [
        0,
        1
      ],
      "wander": 3,
      "chatter": [
        "I can see four days of your road from here. None of it is good.",
        "Sit if you like. Don't stand near the edge in this wind.",
        "Fire's cold. I don't light it where things can see it.",
        "Everything that comes up here comes up the way you did."
      ]
    },
    {
      "name": "Oran the Eightfold Monk",
      "unit": "element_monk",
      "cell": [
        21,
        13
      ],
      "facing": [
        0,
        1
      ],
      "story_npc": "element_monk",
      "talk": {
        "hello": [
          "The wind here is wrong by about a season. You feel it too.",
          "You arrived as a gust. Most people do."
        ],
        "again": [
          "The currents said you'd come back. They are usually right.",
          "Welcome. It snowed here yesterday. It is summer."
        ],
        "ask": [
          {
            "q": "What are the Eight Currents?",
            "a": "Stone, gale, ember, tide, lightning, frost, void and dawn. I was taught to let them pass through me. Lately they push."
          },
          {
            "q": "Why come down from the caves?",
            "a": "The step clock is running fast. Snow in summer, peat burning in winter. The elements are weeping. Someone has to find out what hurts them."
          },
          {
            "q": "Who is with you?",
            "a": "An adept whose soul is a conduit. She does not talk much. Neither do I, until recently."
          }
        ],
        "bye": [
          "Life and death are only weather.",
          "Go. Watch the sky."
        ]
      }
    },
    {
      "name": "the Adept",
      "unit": "avatar_adept",
      "cell": [
        22,
        13
      ],
      "facing": [
        0,
        1
      ],
      "story_npc": "element_monk",
      "chatter": [
        "The currents run thin here.",
        "He listens. I carry."
      ]
    }
  ],
