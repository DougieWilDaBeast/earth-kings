 "spots": [
  {
   "cell": [
    4,
    15
   ],
   "line": "A climbing rope is pegged into the rock here, cut clean a man's height up. Somebody went up and did not want to be followed.",
   "page": true
  },
  {
   "cell": [
    22,
    7
   ],
   "line": "Boot nails driven into a crack as steps, nine of them, and then nothing. Whoever drove them went the long way round after all.",
   "page": true
  },
  {
   "cell": [
    12,
    3
   ],
   "line": "A flat stone on the summit with a name scratched into it. Under the name, in another hand: came down the quick way.",
   "page": true
  },
  {
   "cell": [
    15,
    2
   ],
   "line": "Below the edge there is nothing but cloud, white and slow and a very long way down. Nothing that goes into it comes back."
  },
  {
   "cell": [
    14,
    12
   ],
   "line": "The wind takes the breath out of you before you can use it."
  },
  {
   "cell": [
    15,
    8
   ],
   "line": "From here the shelves step down like a stair built for something larger."
  }
 ],
