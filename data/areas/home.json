  "people": [
    {
      "name": "Bram the Sworn Blade",
      "unit": "bram",
      "cell": [
        10,
        8
      ],
      "facing": [
        0,
        1
      ],
      "wander": 2,
      "chatter": [
        "I'll keep the fire a while. Somebody ought to, the first night.",
        "Stormreach is at the Tower's foot. Walk at the Tower and you'll walk into the city.",
        "The Guild hands out the gates nobody else wants. Shut one, and they'll let you climb.",
        "I had a master once. He'd have known what to make of you falling out of the sky."
      ]
    },
    {
      "name": "Hald the smith",
      "unit": "dwarf_smith",
      "cell": [
        5,
        2
      ],
      "facing": [
        0,
        1
      ],
      "requires": [
        "town:smithy"
      ],
      "chatter": [
        "Muck Muck built the roof. I built the fire. Ask him which matters.",
        "Iron's iron. Bring me something worth hitting."
      ],
      "talk": {
        "hone": { "q": "Can you put an edge on our weapons?", "offer": "Let me see what you carry. Coin first, and I don't do miracles.", "done": "There. Mind the edge." },
        "forge": { "q": "Could you make us something?", "offer": "You've brought the makings. Coin for the fire, and I'll see what they want to be.", "none": "I don't make something out of nothing. Ore and ash, and coin for the fire.", "done": "There. It'll serve." },
        "hello": [
          "Hald. Smith. Muck Muck said there was a forge going begging out here, and there was.",
          "Good ground, this. Flat, and nobody's grandfather buried under it."
        ],
        "again": "Back for more iron?",
        "sells": [
          {
            "item": "iron_blade",
            "restock": true
          },
          {
            "item": "steel_blade"
          },
          {
            "item": "hunting_bow",
            "restock": true
          },
          {
            "item": "orrery_staff",
            "restock": true
          },
          {
            "item": "padded_coat",
            "restock": true
          },
          {
            "item": "scale_shirt"
          },
          {
            "item": "owl_helm"
          }
        ],
        "shop": "Your forge, your prices. I still have to eat.",
        "bye": "Mind the sparks."
      }
    },
    {
      "name": "Ness the healer",
      "unit": "town_elder",
      "cell": [
        12,
        2
      ],
      "facing": [
        0,
        1
      ],
      "requires": [
        "town:infirmary"
      ],
      "chatter": [
        "Clean hands, hot water, and nobody shouting. That's most of it.",
        "Sinner taught me. Don't tell her I said so."
      ],
      "talk": {
        "hello": [
          "Ness. I mend people. Out here it's cheaper than in the city, and the beds are yours anyway."
        ],
        "heal": {
          "price": 650,
          "q": "Patch up my companions.",
          "done": "There. Go easy on them for a day. You won't, but I said it.",
          "whole": "Nobody here needs me. Good.",
          "whole_q": "Can you look us over?"
        },
        "bye": "Come back in one piece."
      }
    },
    {
      "name": "a settler",
      "unit": "town_farmer",
      "cell": [
        4,
        9
      ],
      "facing": [
        0,
        1
      ],
      "wander": 3,
      "requires": [
        "town:wall"
      ],
      "chatter": [
        "We heard there was a wall going up out here. A wall, and nobody's lord.",
        "First crop's in by the rim. The ground's warm. It grows like it's in a hurry."
      ]
    },
    {
      "name": "a settler",
      "unit": "town_fisher",
      "cell": [
        12,
        9
      ],
      "facing": [
        0,
        1
      ],
      "wander": 3,
      "requires": [
        "town:wall"
      ],
      "chatter": [
        "My mother says it's bad luck to live where something fell out of the sky. My mother lives in Stormreach.",
        "They say you came down right there. In the middle. On fire."
      ],
      "talk": {
        "hello": [
          "We came for the wall, and the quiet kept us. What do you want to know?"
        ],
        "news": true,
        "bye": "Mind how you go."
      }
