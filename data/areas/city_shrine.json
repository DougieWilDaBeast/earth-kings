                "hello": [
                    "You're welcome to sit. Mind the sacks; the grocer keeps his onions here.",
                    "Shh. No, talk. The dead don't mind talk. It's the grocer who minds."
                ],
                "ask": [
                    {
                        "q": "Whose shrine was it?",
                        "a": "The fallen's. Before the Cathedral was built, the city lit candles here for anyone who didn't come back from the Tower. Then the Cathedral took the names and the grocer took the room."
                    },
                    {
                        "q": "Why do you light the candles?",
                        "a": "Somebody ought to. My husband went up the year the bells were cast. I light one for him and one for whoever has nobody."
                    },
                    {
                        "q": "Can we light one?",
                        "a": "If you like. Say the name out loud. It doesn't have to be one I know."
                    }
                ],
                "bye": "Come back if you lose someone. Or before."
            },
            "cell": [
