    {
      "name": "Old Stump",
      "unit": "tree_sentinel",
      "cell": [
        5,
        10
      ],
      "facing": [
        1,
        0
      ],
      "chatter": [
        "They cut around me. They have always cut around me.",
        "One side of me bears fruit. Do not eat from the other."
      ],
      "talk": {
        "refuse": {
          "chance": 0.6,
          "text": "Old Stump does not stir. Sap moves, very slowly, somewhere inside.",
          "leave": "Let it sleep.",
          "check": {
            "skill": "renown",
            "dc": 10
          },
          "check_q": "Tell it who you are.",
          "won": "One eye opens, like a knot in the bark coming loose. ...I know that name. Speak.",
          "still_no": "The eye stays shut. Not today, it seems to say. Not this century."
        },
        "hello": "Small one. You walk quickly. Everything walks quickly.",
        "ask": [
          {
            "q": "How old are you?",
            "a": "Old enough to remember when this was all one wood, and the gates were only stories the wood told itself."
          },
          {
            "q": "Why do they cut around you?",
            "a": "Because the first one who tried to cut me is still under me."
          },
          {
            "q": "What's beyond the ridge?",
            "a": "More of me. Fewer of you. That is how it should be."
          }
        ],
        "leave": "Leave it in peace.",
        "bye": "...",
        "more": "The old wood waits."
      }
    },
    {
      "name": "Nix the Cutpurse",
      "unit": "hat_fox",
      "cell": [
        9,
        11
      ],
      "facing": [
        0,
        -1
      ],
      "wander": 4,
      "chatter": [
        "Sawdust hides a great many footprints.",
        "I am only here for the offcuts. Truly."
      ],
      "talk": {
        "refuse": {
          "text": "Nobody here by that name. Never heard of him. Lovely fellow, though.",
          "bribe": 10,
          "bribe_q": "Ten gold says you've heard of him.",
          "won": "Funny. It's all come back to me.",
          "won_flag": "nix:paid",
          "unless": "nix:paid",
          "leave": "Walk on."
        },
        "hello": "Sawdust hides a great many footprints. What are you after?",
        "ask": [
          {
            "q": "Anything worth stealing round here?",
            "a": "The foreman's strongbox. Don't. He sleeps on it, and he's a light sleeper with a heavy axe."
          }
        ],
