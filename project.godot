; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Earth Kings"
config/description="A 2D top-down grid tactical RPG."
config/version="0.1.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/autoload/event_bus.gd"
Database="*res://src/autoload/database.gd"
GameState="*res://src/autoload/game_state.gd"
Music="*res://src/autoload/music.gd"
Sfx="*res://src/autoload/sfx.gd"
Pace="*res://src/autoload/pace.gd"
Pad="*res://src/autoload/pad.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/emulate_touch_from_mouse=true
window/handheld/emulate_mouse_from_touch=true

[gui]

theme/custom="res://art/ui/menu_theme.tres"

