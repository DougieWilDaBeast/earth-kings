{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLM Gateway",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:LLM_GATEWAY_KEY}"
      },
      "models": {
        "strong": { "name": "Gateway strong" },
        "code": { "name": "Gateway code" },
        "cheap": { "name": "Gateway cheap" }
      }
    }
  },
  "model": "gateway/strong",
  "small_model": "gateway/cheap"
}
